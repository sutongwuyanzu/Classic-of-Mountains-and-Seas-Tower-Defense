.page-shell { min-height: 100vh; padding: 34rpx 30rpx 54rpx; box-sizing: border-box; background: #101719; }
.select-screen, .game-screen, .result-screen { max-width: 900rpx; margin: 0 auto; }
.brand-row { display: flex; align-items: center; gap: 18rpx; margin-bottom: 30rpx; }
.crest { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; color: #101719; background: #e4b45d; font-size: 36rpx; font-weight: 700; }
.eyebrow { color: #76c1a5; font-size: 18rpx; letter-spacing: 3rpx; }
.title { margin-top: 5rpx; color: #f1ecdf; font-size: 46rpx; font-weight: 700; }
.intro { color: #a9b5ae; font-size: 24rpx; line-height: 1.7; max-width: 680rpx; margin-bottom: 42rpx; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; color: #f1ecdf; font-size: 28rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #2a393a; }
.muted { color: #7f918a; font-size: 20rpx; }
.stage-list { margin-top: 16rpx; }
.stage-card { display: flex; align-items: center; gap: 18rpx; min-height: 106rpx; margin: 12rpx 0; padding: 18rpx; color: #d7e0d9; background: #172224; border: 1rpx solid #2a393a; text-align: left; }
.stage-card.is-selected { border-color: #e4b45d; background: #202d2c; }
.stage-number { color: #e4b45d; font-size: 22rpx; width: 50rpx; }
.stage-copy { flex: 1; display: flex; flex-direction: column; gap: 7rpx; }
.stage-name { font-size: 28rpx; font-weight: 700; }
.stage-intro { color: #93a49d; font-size: 20rpx; line-height: 1.4; }
.difficulty { color: #d86c4e; font-size: 20rpx; letter-spacing: 4rpx; }
.roster-head { margin-top: 42rpx; }
.roster-scroll, .game-roster { white-space: nowrap; margin: 18rpx -30rpx 28rpx; padding: 0 30rpx; }
.roster-card { display: inline-flex; vertical-align: top; flex-direction: column; align-items: center; width: 142rpx; min-height: 160rpx; margin-right: 12rpx; padding: 18rpx 8rpx; box-sizing: border-box; color: #d7e0d9; background: #172224; border: 1rpx solid #2a393a; }
.roster-card.is-selected { border-color: #76c1a5; }
.portrait, .game-portrait { display: block; width: 62rpx; height: 62rpx; line-height: 62rpx; margin-bottom: 13rpx; border: 2rpx solid currentColor; border-radius: 50%; text-align: center; font-size: 34rpx; font-weight: 700; }
.portrait-image { background-image: url('../../assets/beast-atlas.png'); background-repeat: no-repeat; background-size: 600% 500%; background-color: #bcae88; overflow: hidden; color: transparent; }
.roster-name { font-size: 23rpx; }
.roster-meta { color: #84978f; font-size: 18rpx; margin-top: 8rpx; }
.primary-button, .secondary-button, .skill-button { height: 84rpx; line-height: 84rpx; border-radius: 0; font-size: 26rpx; }
.primary-button { color: #101719; background: #e4b45d; font-weight: 700; }
.primary-button text { float: right; margin-right: 26rpx; font-size: 36rpx; }
.secondary-button { color: #dce5dd; background: #1b292a; border: 1rpx solid #3a4b4a; margin-top: 16rpx; }
.mini-note { color: #7f918a; font-size: 19rpx; line-height: 1.6; margin-top: 22rpx; text-align: center; }
.game-topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.back-button, .top-actions button { height: 58rpx; line-height: 58rpx; padding: 0 16rpx; border-radius: 0; color: #b9c7c0; background: #172224; border: 1rpx solid #2a393a; font-size: 20rpx; }
.terrain, .level { display: block; text-align: center; }.terrain { color: #e4b45d; font-size: 28rpx; }.level { color: #8fa39a; font-size: 18rpx; margin-top: 5rpx; }.top-actions { display: flex; gap: 8rpx; }
.hud-row { display: flex; gap: 10rpx; margin-bottom: 14rpx; }.stat { flex: 1; min-width: 0; padding: 13rpx; background: #172224; border: 1rpx solid #2a393a; color: #e5ece6; font-size: 21rpx; }.stat.compact { flex: 0 0 90rpx; text-align: center; }.stat-label { display: block; color: #84978f; font-size: 17rpx; margin-bottom: 8rpx; }.big-number { color: #e4b45d; font-size: 28rpx; font-weight: 700; }.meter { height: 6rpx; margin-top: 9rpx; background: #293535; }.meter view { height: 100%; background: #76c1a5; }.wave-dots { display: flex; gap: 3rpx; margin-top: 14rpx; }.wave-dots i { display: block; flex: 1; height: 5rpx; background: #293535; }.wave-dots i.done { background: #76c1a5; }.wave-dots i.current { background: #e4b45d; }
.combat-log { min-height: 34rpx; color: #a9b5ae; font-size: 19rpx; margin: 12rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.arena { display: block; width: 100%; height: 53.4vw; max-height: 506rpx; min-height: 280rpx; background: #152124; border: 1rpx solid #314342; }.arena-hint { color: #7f918a; font-size: 18rpx; margin: 12rpx 0 18rpx; }
.game-roster { margin: 0 -30rpx 16rpx; }.game-card { display: inline-flex; vertical-align: top; align-items: center; gap: 10rpx; width: 176rpx; height: 76rpx; margin-right: 10rpx; padding: 8rpx; box-sizing: border-box; color: #d7e0d9; background: #172224; border: 1rpx solid #2a393a; font-size: 20rpx; }.game-card.is-selected { border-color: #e4b45d; }.game-portrait { flex: 0 0 42rpx; width: 42rpx; height: 42rpx; line-height: 42rpx; margin: 0; font-size: 23rpx; }.cost { margin-left: auto; color: #e4b45d; font-size: 18rpx; }.game-actions { display: flex; gap: 12rpx; }.game-actions button { flex: 1; margin: 0; }.skill-button { color: #b9c7c0; background: #1b292a; border: 1rpx solid #3a4b4a; }.skill-button.ready { color: #101719; background: #76c1a5; }
.result-screen { padding-top: 180rpx; text-align: center; }.result-kicker { color: #e4b45d; font-size: 24rpx; }.result-title { color: #f1ecdf; font-size: 44rpx; font-weight: 700; margin: 22rpx 0 52rpx; }.result-grid { display: flex; gap: 10rpx; }.result-grid view { flex: 1; padding: 22rpx 8rpx; background: #172224; border: 1rpx solid #2a393a; }.result-grid text, .result-grid strong { display: block; }.result-grid text { color: #84978f; font-size: 18rpx; }.result-grid strong { color: #e4b45d; font-size: 34rpx; margin-top: 10rpx; }.result-copy { color: #a9b5ae; font-size: 22rpx; line-height: 1.7; margin: 40rpx 20rpx; }
@media (max-width: 380px) { .stat.compact { flex-basis: 72rpx; }.stat { padding: 10rpx 7rpx; }.game-card { width: 160rpx; } }
