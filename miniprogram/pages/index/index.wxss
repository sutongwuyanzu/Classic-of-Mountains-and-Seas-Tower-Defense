.page-shell { min-height: 100vh; box-sizing: border-box; padding: 26rpx 24rpx 48rpx; color: #f1ecdf; background: #121b1d; }
.select-screen, .game-screen, .result-screen { width: 100%; max-width: 960rpx; margin: 0 auto; }
.brand-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }.crest { width: 62rpx; height: 62rpx; line-height: 62rpx; text-align: center; color: #162021; background: #e4b45d; font-size: 36rpx; font-weight: 700; }.eyebrow { color: #76c1a5; font-size: 16rpx; letter-spacing: 2rpx; }.title { margin-top: 4rpx; font-size: 42rpx; font-weight: 700; }.intro { max-width: 760rpx; margin-bottom: 28rpx; color: #a9b5ae; font-size: 22rpx; line-height: 1.6; }
.section-head, .dock-title, .modal-head { display: flex; align-items: center; justify-content: space-between; }.section-head { padding-bottom: 12rpx; border-bottom: 1rpx solid #344244; font-size: 27rpx; }.muted { color: #91a19a; font-size: 18rpx; }
.stage-list { display: flex; gap: 10rpx; margin: 14rpx 0 22rpx; overflow-x: auto; }.stage-card { flex: 1 0 176rpx; min-height: 176rpx; position: relative; overflow: hidden; border: 1rpx solid #3b4a46; background: #1a2829; }.stage-card.is-selected { border: 2rpx solid #e4b45d; }.stage-art { height: 84rpx; opacity: .82; background-position: center; background-size: cover; }.stage-art-0 { background-image: url('../../assets/background-cave.webp'); }.stage-art-1 { background-image: url('../../assets/background-grass.webp'); }.stage-art-2 { background-image: url('../../assets/background-sea.webp'); }.stage-art-3 { background-image: url('../../assets/background-volcano.webp'); }.stage-art-4 { background-image: url('../../assets/background-heaven.webp'); }.stage-copy { padding: 10rpx; }.stage-number { color: #e4b45d; font-size: 18rpx; }.stage-name { display: block; margin-top: 4rpx; font-size: 24rpx; font-weight: 700; }.stage-intro { display: block; margin-top: 4rpx; color: #a1b0a8; font-size: 16rpx; line-height: 1.35; }.stage-side { position: absolute; right: 8rpx; bottom: 9rpx; text-align: right; }.difficulty { color: #d86c4e; font-size: 17rpx; }.wave-count { display: block; margin-top: 4rpx; color: #e4b45d; font-size: 16rpx; }
.select-actions { display: flex; gap: 12rpx; }.primary-button, .outline-button, .secondary-button, .summon-button, .skill-button { min-height: 74rpx; border-radius: 0; font-size: 23rpx; }.primary-button { color: #172021; background: #e4b45d; font-weight: 700; }.primary-button text { float: right; margin-right: 22rpx; font-size: 32rpx; }.outline-button { color: #e8d4a0; background: #1c2a2b; border: 1rpx solid #b78c4a; }.outline-button text { float: right; margin-right: 20rpx; }.select-actions button { flex: 1; }.selection-note { margin: 14rpx 2rpx 0; color: #81938a; font-size: 17rpx; line-height: 1.5; }
.game-topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }.back-button, .top-actions button, .rail-button, .small-link { border-radius: 0; color: #e8eee8; background: #1b292a; border: 1rpx solid #3c4c49; }.back-button, .top-actions button { min-height: 54rpx; line-height: 54rpx; padding: 0 14rpx; font-size: 20rpx; }.top-title { text-align: center; }.terrain { display: block; color: #e4b45d; font-size: 27rpx; font-weight: 700; }.level { display: block; margin-top: 3rpx; color: #9baaa1; font-size: 17rpx; }.top-actions { display: flex; gap: 8rpx; }.hud-row { display: flex; gap: 8rpx; margin-bottom: 8rpx; }.stat { flex: 1; min-width: 0; padding: 10rpx; border: 1rpx solid #344244; background: #1a2829; }.stat.compact { flex: 0 0 78rpx; text-align: center; }.stat-label { display: block; color: #8fa099; font-size: 16rpx; }.stat-value { display: block; margin-top: 4rpx; color: #f1ecdf; font-size: 20rpx; }.big-number { display: block; margin-top: 6rpx; color: #e4b45d; font-size: 27rpx; font-weight: 700; }.meter { height: 6rpx; margin-top: 7rpx; background: #30403f; }.meter view { height: 100%; background: #d86c4e; }.wave-dots { display: flex; gap: 2rpx; margin-top: 10rpx; }.wave-dots i { flex: 1; height: 5rpx; background: #30403f; }.wave-dots i.done { background: #76c1a5; }.wave-dots i.current { background: #e4b45d; }.combat-log { min-height: 30rpx; padding: 4rpx 8rpx; box-sizing: border-box; color: #d9c790; background: #1b292a; font-size: 17rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.battle-wrap { position: relative; margin-top: 8rpx; }.arena { display: block; width: 100%; height: 54vw; max-height: 528rpx; min-height: 280rpx; border: 1rpx solid #556259; background: #1a2829; }.arena-hint { position: absolute; left: 12rpx; bottom: 8rpx; padding: 5rpx 8rpx; color: #f2e1b3; background: rgba(14,25,25,.72); font-size: 16rpx; }.command-rail { display: flex; gap: 8rpx; margin-top: 8rpx; }.rail-button { flex: 1; min-height: 62rpx; padding: 7rpx; text-align: center; }.rail-button strong, .rail-button small { display: block; }.rail-button strong { color: #f0d08a; font-size: 20rpx; }.rail-button small { margin-top: 3rpx; color: #9aa8a0; font-size: 15rpx; }.fortune-button { border-color: #c08b48; }.summon-dock { margin-top: 8rpx; padding: 12rpx; border-top: 1rpx solid #3a4a46; background: #172425; }.dock-title { margin-bottom: 8rpx; font-size: 22rpx; }.small-link { padding: 5rpx 9rpx; color: #e4b45d; font-size: 16rpx; }.owned-scroll { white-space: nowrap; min-height: 78rpx; }.empty-owned { display: inline-block; padding: 24rpx 8rpx; color: #8ea098; font-size: 17rpx; }.owned-card { display: inline-flex; align-items: center; vertical-align: top; width: 178rpx; height: 72rpx; margin-right: 8rpx; padding: 7rpx; box-sizing: border-box; border: 1rpx solid #3a4a46; background: #203031; }.owned-card.is-selected { border: 2rpx solid #e4b45d; }.game-portrait { flex: 0 0 52rpx; width: 52rpx; height: 52rpx; }.owned-copy { min-width: 0; margin-left: 8rpx; }.owned-copy text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.owned-copy text:first-child { font-size: 20rpx; }.rarity { margin-top: 4rpx; font-size: 15rpx; }.portrait-image { display: block; border: 2rpx solid #a98b5d; border-radius: 50%; background-image: url('../../assets/beast-atlas.webp'); background-repeat: no-repeat; background-size: 600% 500%; background-color: #b8aa82; overflow: hidden; }.summon-actions { display: flex; gap: 8rpx; margin-top: 9rpx; }.summon-button, .skill-button { flex: 1; min-height: 60rpx; color: #182021; background: #d9a45b; font-size: 18rpx; }.summon-button text { float: right; margin-right: 9rpx; font-size: 18rpx; }.summon-button.advanced { background: #bb7855; color: #fff2d0; }.skill-button { color: #b5c4ba; background: #263536; border: 1rpx solid #53645b; }.skill-button.ready { color: #172021; background: #76c1a5; }
.result-screen { padding-top: 160rpx; text-align: center; }.result-kicker { color: #e4b45d; font-size: 23rpx; }.result-title { margin: 18rpx 0 38rpx; font-size: 42rpx; font-weight: 700; }.result-grid { display: flex; gap: 8rpx; }.result-grid view { flex: 1; padding: 18rpx 6rpx; border: 1rpx solid #344244; background: #1a2829; }.result-grid text { display: block; color: #8fa099; font-size: 16rpx; }.result-grid .result-number { margin-top: 8rpx; color: #e4b45d; font-size: 30rpx; }.result-copy { margin: 28rpx 14rpx; color: #abb8af; font-size: 20rpx; line-height: 1.6; }.result-screen button { width: 100%; }.secondary-button { color: #dce5dd; background: #1b292a; border: 1rpx solid #3a4b4a; margin-top: 12rpx; }
.modal-mask { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 24rpx; box-sizing: border-box; background: rgba(5,12,13,.78); }.modal-sheet { width: 100%; max-width: 900rpx; max-height: 88vh; padding: 18rpx; box-sizing: border-box; border: 1rpx solid #b78c4a; background: #1b292a; box-shadow: 0 12rpx 36rpx rgba(0,0,0,.35); }.modal-head { padding-bottom: 12rpx; border-bottom: 1rpx solid #42504a; color: #f1ecdf; font-size: 27rpx; font-weight: 700; }.modal-head button { width: 48rpx; height: 48rpx; line-height: 42rpx; padding: 0; color: #f1ecdf; background: transparent; font-size: 34rpx; }.modal-tip { padding: 12rpx 0; color: #aebbb0; font-size: 17rpx; }.offer-grid { display: flex; flex-wrap: wrap; gap: 8rpx; max-height: 68vh; overflow-y: auto; }.offer-card { flex: 1 0 180rpx; min-height: 218rpx; padding: 12rpx 8rpx; box-sizing: border-box; border: 1rpx solid #526158; background: #243333; text-align: center; }.large-portrait { width: 84rpx; height: 84rpx; margin: 4rpx auto 10rpx; }.offer-name, .offer-rarity, .offer-skill, .claim-label { display: block; }.offer-name { font-size: 22rpx; }.offer-rarity { margin-top: 4rpx; font-size: 17rpx; }.offer-skill { margin-top: 6rpx; color: #9eb0a4; font-size: 16rpx; }.claim-label { margin-top: 13rpx; color: #e4b45d; font-size: 15rpx; }.backpack-grid, .atlas-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; }.backpack-card { padding: 10rpx 4rpx; border: 1rpx solid #40504a; text-align: center; font-size: 16rpx; }.backpack-card text { display: inline-block; margin: 0 3rpx; }.atlas-scroll { max-height: 68vh; }.atlas-card { display: flex; align-items: center; min-height: 100rpx; padding: 8rpx; border: 1rpx solid #40504a; background: #223131; }.atlas-card .large-portrait { flex: 0 0 68rpx; width: 68rpx; height: 68rpx; margin: 0 9rpx 0 0; }.atlas-name, .atlas-meta { display: block; }.atlas-name { font-size: 20rpx; }.atlas-meta { margin-top: 3rpx; color: #aab8ae; font-size: 14rpx; }.bond-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 4rpx; border-bottom: 1rpx solid #394944; }.bond-row.ready { color: #e4b45d; }.bond-name, .bond-effect { display: block; }.bond-name { font-size: 21rpx; }.bond-effect { margin-top: 5rpx; color: #99aaa0; font-size: 16rpx; }.bond-count { color: #d86c4e; font-size: 18rpx; }.bond-row.ready .bond-count { color: #76c1a5; }.fortune-modal { padding: 28rpx 12rpx 12rpx; text-align: center; }.fortune-seal { width: 94rpx; height: 94rpx; line-height: 94rpx; margin: 0 auto 18rpx; border: 2rpx solid #d86c4e; border-radius: 50%; color: #d86c4e; font-size: 42rpx; }.fortune-result { display: block; color: #f0d08a; font-size: 26rpx; }.fortune-refund { display: block; margin-top: 9rpx; color: #76c1a5; font-size: 19rpx; }.fortune-modal .primary-button { width: 100%; margin-top: 24rpx; }
@media (max-width: 520px) { .page-shell { padding: 18rpx 16rpx 36rpx; }.stage-card { flex-basis: 178rpx; }.stat.compact { flex-basis: 66rpx; }.stat { padding: 8rpx 6rpx; }.stat-label { font-size: 14rpx; }.game-portrait { flex-basis: 46rpx; width: 46rpx; height: 46rpx; }.owned-card { width: 158rpx; }.summon-button, .skill-button { font-size: 16rpx; }.backpack-grid, .atlas-grid { grid-template-columns: repeat(3, 1fr); }.modal-sheet { padding: 14rpx; } }
.wave-dots .dot { display: block; flex: 1; height: 5rpx; background: #30403f; }.wave-dots .dot.done { background: #76c1a5; }.wave-dots .dot.current { background: #e4b45d; }.rail-title, .rail-sub { display: block; }
