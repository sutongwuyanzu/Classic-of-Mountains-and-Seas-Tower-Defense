{
  "name": "classic-of-mountains-and-seas-tower-defense",
  "version": "0.1.0",
  "buildId": "sol-3d-combat-42",
  "private": true,
  "author": "sutongwuyanzu",
  "main": "electron/main.cjs",
  "description": "A standalone browser reconstruction of a Shan Hai Jing tower defense game.",
  "scripts": {
    "dev": "python -m http.server 4173",
    "steam": "electron electron/main.cjs",
    "dist:steam": "electron-builder --config electron-builder.yml",
    "dist:portable": "electron-builder --config electron-builder.yml --win portable",
    "dist:unpacked": "powershell -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "manifest:steam": "node scripts/steam-release-manifest.cjs",
    "check:steampipe": "node scripts/check-steampipe-template.cjs",
    "sync:wechat": "powershell -ExecutionPolicy Bypass -File scripts/sync-wechatgame.ps1",
    "check": "node scripts/check-game.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  }
}
